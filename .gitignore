__pycache__/
*.py[cod]

# Checkpoints are ~1.1GB each and live in S3, not git.
*.pt
*.pt.tmp

# Generated artefacts. The tokenizer is rebuilt by scripts/train_tokenizer.py,
# but note that a DIFFERENT tokenizer silently invalidates every checkpoint --
# the one a run actually used is published alongside its weights in S3.
tokenizer.json

# Durable run metrics are mirrored to S3 with their checkpoints; keeping them
# here would mix one machine's history into the source tree.
*.jsonl
*.npy
*.npz
metrics/

# LaTeX build products. report.pdf is COMMITTED deliberately -- it is the
# deliverable, and it must not depend on a reader having MiKTeX installed.
report/*.aux
report/*.log
report/*.out
report/build*.log
report/b1.log
report/b2.log

# ...but the metrics the report is BUILT from are evidence, not machine
# history, so they are tracked despite the *.jsonl rule above. Without them
# report/make_figures.py cannot run and every figure becomes unverifiable.
!runs/metrics/
!runs/metrics/*.jsonl
!runs/metrics/*.csv
!runs/metrics/*.json
!runs/results/*

# Captured client requests are for one-off measurement, not source. The one
# that matters is copied into runs/results/claude_code_request.json as evidence.
serve/captured/
serve/probe.log
